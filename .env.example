# Copie para .env e ajuste. O arquivo .env nao vai para o git.
# Todos os valores sao opcionais; os padroes estao em src/main/config.ts.

# Intervalo de amostragem em ms (500..10000)
VITALS_SAMPLE_MS=1500

# Pontos de historico mantidos em memoria por serie
VITALS_HISTORY_POINTS=120

# API HTTP local somente-leitura (1 liga, 0 desliga). Escuta so em 127.0.0.1.
VITALS_HTTP=1
VITALS_HTTP_PORT=4780

# Habilita botoes de encerramento de processo na UI
VITALS_ACTIONS=1

# Tempo de espera do encerramento gracioso antes de sugerir "forcar" (ms)
VITALS_GRACEFUL_TIMEOUT_MS=3000

# Intervalo do netstat para descobrir portas (ms, 3000..60000)
VITALS_PORTS_MS=10000

# Bandeja do sistema: fechar a janela esconde o HUD (1) ou encerra (0).
VITALS_TRAY=1

# Diretorio de logs/auditoria. Padrao: %APPDATA%\Vitals\logs
# VITALS_LOG_DIR=D:\Monitor\logs

# ---- Acoes via API HTTP (POST /api/terminate) -----------------------------
# Exige AS DUAS coisas: VITALS_REMOTE_ACTIONS=1 e um token com >= 16 chars.
# Sem isso, a API e somente leitura (o que e o recomendado).
# VITALS_REMOTE_ACTIONS=1
# VITALS_HTTP_TOKEN=troque-este-token-de-16-ou-mais-caracteres

# ---- Diagnostico ----------------------------------------------------------
# 1 = nao escreve log no console (o arquivo continua). O probe --json liga
# isso automaticamente para o stdout ser JSON puro.
# VITALS_LOG_SILENT=1

# debug | info | warn | error (debug so aparece no console se explicitado)
# VITALS_LOG_LEVEL=info
